# ── Vercel / hosting environment ───────────────────────────────────────
# Copy this file to `.env` (frontend/) or `.env.local` for local dev.
# On Vercel: Project → Settings → Environment Variables.
#
# NOTE: Vite inlines VITE_* variables at BUILD time. After changing any VITE_*
# value in Vercel you must redeploy (or rebuild) for it to take effect.

# FastAPI base URL, INCLUDING the /api/v1 prefix.
# Leave empty to run fully on mock data (offline demo mode).
VITE_API_BASE_URL=https://your-api.vercel.app/api/v1

# Supabase (frontend-safe anon key only — never put the service_role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=